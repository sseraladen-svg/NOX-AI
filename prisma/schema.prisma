// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────────────────
// NOX AI — Local database schema
//
// Everything is user-scoped. A user signs up / logs in with email + password
// (hashed with scrypt). All multi-model configs and chat conversations belong
// to a single user.
// ───────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  multiModelConfigs MultiModelConfig[]
  conversations     Conversation[]
  usageRecords      UsageRecord[]
}

model MultiModelConfig {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  scope String @default("default")
  mode String @default("SINGLE")
  globalConfig String?
  featureConfigs String?
  hostConfig String?
  specialistConfigs String?
  timeoutOverrides String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, scope])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  mode      String   @default("SINGLE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  trace          String?
  orchestration  String?
  mode           String?
  multiAgent     Boolean  @default(false)
  error          Boolean  @default(false)
  usage          String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

model UsageRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  messageId      String?
  mode           String
  role           String
  provider       String
  model          String
  connectionType String
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  inputCost      Float?
  outputCost     Float?
  totalCost      Float?
  latencyMs      Int
  retries        Int      @default(0)
  timedOut       Boolean  @default(false)
  error          Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, provider, model])
  @@index([conversationId])
}
